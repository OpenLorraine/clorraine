module Probe.Main;

import { println } from std.io;
import { Tok, tok, idOf, show } from Probe.Tok;

func main(): i32 {
    let a: Tok = tok(1);
    defer {
        println("outer");
    }
    {
        let b: Tok = tok(2);
        defer {
            println("inner");
        }
        println("block");
    }
    println("after");
    println("end");
    return 0;
}
