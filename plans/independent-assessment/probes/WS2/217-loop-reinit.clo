module Probe.Main;

import { println } from std.io;
import { Tok, tok, idOf, show } from Probe.Tok;

func consume(take t: Tok): void {
    show(t);
}

func main(): i32 {
    let a: Tok = tok(1);
    let i: u8 = 0;
    while (i < 3) {
        consume(take a);
        a = tok(i + 2);
        i = i + 1;
    }
    show(a);
    println("end");
    return 0;
}
