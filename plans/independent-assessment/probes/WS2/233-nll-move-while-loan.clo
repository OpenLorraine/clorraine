module Probe.Main;

import { println } from std.io;
import { Array, arrayNew } from std.mem;

func consume(take xs: Array<i32>): void {
}

func main(): i32 {
    let xs: Array<i32> = arrayNew<i32>();
    xs.push(1);
    let v: i32[] = xs.get(0);
    consume(take xs);
    println($"{v[0]}");
    return 0;
}
