module Probe.Main;

import { println } from std.io;
import { Tok, tok, idOf, show } from Probe.Tok;

func consume(take t: Tok): void {
    show(t);
}

func main(): i32 {
    let a: Tok = tok(1);
    let i: i32 = 0;
    while (i < 2) {
        consume(take a);
        i = i + 1;
    }
    println("end");
    return 0;
}
