module Probe.Main;

import { println } from std.io;
import { Tok, tok, idOf, show } from Probe.Tok;

func main(): i32 {
    let i: u8 = 0;
    while (i < 2) {
        let o: Tok = tok(i + 10);
        let j: u8 = 0;
        while (true) {
            let n: Tok = tok(j + 20);
            if (j == 1) {
                break;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    println("end");
    return 0;
}
