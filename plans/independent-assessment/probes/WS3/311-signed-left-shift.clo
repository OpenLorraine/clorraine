module Probe.Main;

import { println } from std.io;

func shl(a: i32, n: i32): i32 {
    return a << n;
}

func shlAssign(a: i32): i32 {
    let x: i32 = a;
    x <<= 4;
    return x;
}

func main(): i32 {
    println($"{shl(-1, 3)} {shl(1, 31)} {shl(1073741824, 1)} {shlAssign(-2)}");
    return 0;
}
