module Probe.Main;

import { println } from std.io;
import { Array, arrayNew } from std.mem;
func pick(n: usize): usize {
    return n;
}

func main(): i32 {
    let xs: Array<i32> = arrayNew<i32>();
    xs.push(1);
    xs.push(2);
    xs.push(3);
    println($"{xs.get(pick(3))[0]}");
    return 0;
}
