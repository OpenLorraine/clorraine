# Clorraine SDK local configuration template.
#
# `make init` copies this into docker/.env (gitignored) and fills in values
# detected on your machine. Edit docker/.env, not this file.
#
# Compose interpolates these variables; they are not passed into containers
# unless a service declares them.

# Image tag built by `make image`.
IMAGE=clorraine-sdk:dev

# Host folder holding Amiga test media (ROMs, ADFs, HDFs). It is mounted
# read-only at /amiga inside the container. Keep it OUTSIDE the repository.
AMIGA_DATA=/home/you/amiga

# X11 display and cookie used to show the emulator window on your desktop.
DISPLAY=:0
XAUTHORITY=/home/you/.Xauthority

# Kickstart ROM. "internal" uses FS-UAE's built-in AROS replacement ROM,
# which needs no ROM files. To use your own ROM, set a container path:
#   KICKSTART=/amiga/roms/amiga-os-310-a1200.rom
KICKSTART=internal

# Amiga model passed to FS-UAE: A500, A600, A1200, A3000, A4000, CD32.
AMIGA_MODEL=A1200

# Extra arguments appended to every fs-uae invocation.
FS_UAE_ARGS=

# Boot media for `make run`:
#   dir = directory hard drive built from build/run (fast, recommended)
#   adf = bootable floppy image generated with xdftool (deterministic fallback)
RUNNER=dir

# Program output for `make run`:
#   0 = visible in the emulator window (default, best for debugging)
#   1 = captured to build/run/out.txt on the host (use for automation/CI)
RUN_CAPTURE=0
