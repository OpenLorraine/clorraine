# Pinned build inputs for the Clorraine Amiga SDK.
#
# Ownership policy: this file plus docker/Dockerfile are the only build inputs.
# No third-party prebuilt toolchain images are used. Toolchains are built from
# pinned upstream revisions so that we can update or patch them ourselves.
#
# Update procedure:
#   1. Set AMIGA_GCC_COMMIT to a newer commit of AMIGA_GCC_REPO.
#   2. Run `make image` and `make smoke` in this directory.
#   3. The exact submodule revisions used are recorded in the image at
#      /opt/amiga/BUILD-PROVENANCE.txt.

AMIGA_GCC_REPO=https://github.com/AmigaPorts/m68k-amigaos-gcc
AMIGA_GCC_COMMIT=e7ed7a735c4dd9d2c47e23a50e51b2b7ddd4688c

DEBIAN_VERSION=bookworm

# Parallel build jobs for the toolchain. Keep this conservative: a GCC
# bootstrap can use well over 1 GB of RAM per job.
BUILD_JOBS=4

# Build targets of the pinned amiga-gcc Makefile:
#   min      binutils + gcc (C/C++/ObjC) + gprof + libnix + libgcc
#   gdb      m68k-amigaos-gdb for the build host
#   ndk      AmigaOS NDK 3.2 headers/inlines from Aminet (SHA-256 checked)
#   vasm     assembler used by vbcc
#   vbcc     vbcc C compiler for the build host
#   vlink    linker used by vbcc
#   fd2sfd   NDK .sfd to .h conversion helper
#   fd2pragma wrapper generator
TOOLCHAIN_TARGETS=min gdb ndk vasm vbcc vlink fd2sfd fd2pragma
