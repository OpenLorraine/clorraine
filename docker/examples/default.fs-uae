# Example FS-UAE configuration for interactive use from the SDK.
#
# Inside the container these paths exist:
#   /amiga  host AMIGA_DATA folder, mounted read-only (ROMs, ADFs, HDFs)
#   /work   this repository
#
# Copy this file to your Amiga data folder (for example
# ~/amiga/config/default.fs-uae) and adjust it, then run from the host:
#
#   make emulator FS_UAE_ARGS="--config-file=/amiga/config/default.fs-uae"
#
# Command-line options passed after --config-file override the file.

amiga_model = A1200
kickstart_file = internal

# Example hard disk image (uncomment and adjust):
# hard_drive_0 = /amiga/hdf/workbench31.hdf
# hard_drive_0_priority = 0

# Example floppy image:
# floppy_drive_0 = /amiga/adf/workbench-3.1.adf

window_width = 960
window_height = 720
