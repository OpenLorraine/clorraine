# Chapter 1: show real Clorraine source with syntax highlighting in Vim.
#
# Recorded by demo/story.sh from the repository root. The output path is
# relative to the repository root.
Output build/demo/raw/source.mp4
Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 620
Set Padding 20
Set Theme "Dracula"
Set TypingSpeed 80ms

Type "demo/show-source.sh spec/tests/corpus/string-parser/program.clo"
Enter
Sleep 10s
Type "G"
Sleep 10s
Type ":q"
Enter
Sleep 1s
