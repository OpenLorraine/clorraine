// A rotating 3D cube, drawn line by line on a custom Amiga screen.
//
// The eight corners are turned about two axes with a small fixed-point sine
// table, projected onto the screen, and joined by twelve lines. Each frame
// erases the wireframe it drew last time before drawing the new one, so the
// cube spins smoothly without a double buffer. The screen is owned by
// drawScene, so it is released before the program reports success.
module demo.Cube;

import { Screen, openScreen } from std.amiga.intuition;
import { setColor, draw, clear } from std.amiga.graphics;
import { String, stringOf, toCString } from std.text;
import { println } from std.io;
import { delayTicks } from std.amiga.dos;

// The cube's half-size in world units, the camera distance, and the fixed-point
// scale for the sine table. The projected cube stays inside a 320x256 screen:
// its largest offset is about CUBE * sqrt(3) * CAMERA / (CAMERA - CUBE * sqrt(3))
// = 116 pixels, so it never reaches the edge.
const CUBE: i32 = 50;
const CAMERA: i32 = 340;
const FP: i32 = 256;

// The animation length: 800 frames at 50 frames per second is 16 seconds.
const FRAMES: i32 = 800;

// Draws the animation and holds the screen, then releases it on return.
//
// Returns zero on success and one when the screen cannot be opened.
func drawScene(): i32 {
    let title: String = stringOf("Clorraine 3D");
    let screen: Screen? = openScreen(320, 256, 4, toCString(title));
    if (screen == null) {
        return 1;
    }

    // Pen 0 is the black background; pens 1..15 are a rainbow the cube cycles
    // through, one pen per frame.
    setColor(screen, 0, 0, 0, 0);
    setColor(screen, 1, 255, 0, 0);
    setColor(screen, 2, 255, 128, 0);
    setColor(screen, 3, 255, 255, 0);
    setColor(screen, 4, 128, 255, 0);
    setColor(screen, 5, 0, 255, 0);
    setColor(screen, 6, 0, 255, 128);
    setColor(screen, 7, 0, 255, 255);
    setColor(screen, 8, 0, 128, 255);
    setColor(screen, 9, 0, 0, 255);
    setColor(screen, 10, 128, 0, 255);
    setColor(screen, 11, 255, 0, 255);
    setColor(screen, 12, 255, 0, 128);
    setColor(screen, 13, 192, 192, 192);
    setColor(screen, 14, 255, 255, 255);
    setColor(screen, 15, 255, 64, 0);
    clear(screen, 0);

    // sin(2*pi*k/256) scaled by FP, for k in 0..255. The table is fine enough
    // that one step per frame gives smooth motion at 50 frames per second. The
    // cosine of an angle is the entry sixty-four steps ahead.
    let sine: i32[256] = [
        0, 6, 13, 19, 25, 31, 38, 44, 50, 56, 62, 68, 74, 80, 86, 92,
        98, 104, 109, 115, 121, 126, 132, 137, 142, 147, 152, 157, 162, 167, 172, 177,
        181, 185, 190, 194, 198, 202, 206, 209, 213, 216, 220, 223, 226, 229, 231, 234,
        237, 239, 241, 243, 245, 247, 248, 250, 251, 252, 253, 254, 255, 255, 256, 256,
        256, 256, 256, 255, 255, 254, 253, 252, 251, 250, 248, 247, 245, 243, 241, 239,
        237, 234, 231, 229, 226, 223, 220, 216, 213, 209, 206, 202, 198, 194, 190, 185,
        181, 177, 172, 167, 162, 157, 152, 147, 142, 137, 132, 126, 121, 115, 109, 104,
        98, 92, 86, 80, 74, 68, 62, 56, 50, 44, 38, 31, 25, 19, 13, 6,
        0, -6, -13, -19, -25, -31, -38, -44, -50, -56, -62, -68, -74, -80, -86, -92,
        -98, -104, -109, -115, -121, -126, -132, -137, -142, -147, -152, -157, -162, -167, -172, -177,
        -181, -185, -190, -194, -198, -202, -206, -209, -213, -216, -220, -223, -226, -229, -231, -234,
        -237, -239, -241, -243, -245, -247, -248, -250, -251, -252, -253, -254, -255, -255, -256, -256,
        -256, -256, -256, -255, -255, -254, -253, -252, -251, -250, -248, -247, -245, -243, -241, -239,
        -237, -234, -231, -229, -226, -223, -220, -216, -213, -209, -206, -202, -198, -194, -190, -185,
        -181, -177, -172, -167, -162, -157, -152, -147, -142, -137, -132, -126, -121, -115, -109, -104,
        -98, -92, -86, -80, -74, -68, -62, -56, -50, -44, -38, -31, -25, -19, -13, -6,
    ];

    // The eight corners of a cube centred on the origin.
    let vx: i32[8] = [-CUBE, CUBE, CUBE, -CUBE, -CUBE, CUBE, CUBE, -CUBE];
    let vy: i32[8] = [-CUBE, -CUBE, CUBE, CUBE, -CUBE, -CUBE, CUBE, CUBE];
    let vz: i32[8] = [-CUBE, -CUBE, -CUBE, -CUBE, CUBE, CUBE, CUBE, CUBE];

    // The twelve edges, as pairs of corner indices.
    let edges: i32[24] = [0, 1, 1, 2, 2, 3, 3, 0, 4, 5, 5, 6, 6, 7, 7, 4, 0, 4, 1, 5, 2, 6, 3, 7];

    // The projected corners of the previous frame (px/py) and of the frame being
    // built (nx/ny). Erasing and redrawing one edge at a time keeps every other
    // edge on screen, so the cube stays solid without a double buffer.
    let px: i32[8] = [; 0];
    let py: i32[8] = [; 0];
    let nx: i32[8] = [; 0];
    let ny: i32[8] = [; 0];

    let angleX: i32 = 0;
    let angleY: i32 = 0;
    let frame: i32 = 0;
    while (frame < FRAMES) {
        let pen: u8 = u8(frame % 15 + 1);

        // The rotation for this frame: about X by angleX, about Y by angleY.
        let sa: i32 = sine[usize(angleX)];
        let ca: i32 = sine[usize((angleX + 64) % 256)];
        let sb: i32 = sine[usize(angleY)];
        let cb: i32 = sine[usize((angleY + 64) % 256)];

        // Turn each corner about X, then about Y, then project it to the screen.
        // Division is integer; the small truncation only rounds a pixel.
        let i: i32 = 0;
        while (i < 8) {
            let x: i32 = vx[usize(i)];
            let y: i32 = vy[usize(i)];
            let z: i32 = vz[usize(i)];
            let y1: i32 = (y * ca - z * sa) / FP;
            let z1: i32 = (y * sa + z * ca) / FP;
            let x2: i32 = (x * cb + z1 * sb) / FP;
            let z2: i32 = (z1 * cb - x * sb) / FP;
            let denom: i32 = CAMERA + z2;
            nx[usize(i)] = 160 + (x2 * CAMERA) / denom;
            ny[usize(i)] = 128 - (y1 * CAMERA) / denom;
            i = i + 1;
        }

        // Move the wireframe one edge at a time: erase the edge's old position in
        // the background pen, then draw it at its new position in the frame pen.
        let e: i32 = 0;
        while (e < 12) {
            let a: i32 = edges[usize(e * 2)];
            let b: i32 = edges[usize(e * 2 + 1)];
            draw(screen, px[usize(a)], py[usize(a)], px[usize(b)], py[usize(b)], 0);
            draw(screen, nx[usize(a)], ny[usize(a)], nx[usize(b)], ny[usize(b)], pen);
            e = e + 1;
        }

        // This frame becomes the previous frame for the next iteration.
        i = 0;
        while (i < 8) {
            px[usize(i)] = nx[usize(i)];
            py[usize(i)] = ny[usize(i)];
            i = i + 1;
        }

        // A full turn about Y takes about five seconds; about X, three times
        // longer. One table step per frame keeps both smooth at 50 fps.
        angleY = (angleY + 1) % 256;
        if (frame % 3 == 0) {
            angleX = (angleX + 1) % 256;
        }
        frame = frame + 1;
        delayTicks(1);
    }

    return 0;
}

func main(): i32 {
    let rc: i32 = drawScene();
    if (rc != 0) {
        println("cube: failed");
        return rc;
    }
    println("cube: ok");
    return 0;
}
