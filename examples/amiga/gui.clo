//! GUI acceptance demo: a light 640x256 desktop with a name field, a button,
//! command-key menus, two Yes/No requesters, and the built-in pointer on a
//! Kickstart 1.3 A500.
//!
//! The field is activated with `ActivateGadget`, so the smoke can type with a
//! virtual keyboard without positioning a pointer. The menu items carry
//! command keys (Right Amiga + H/A/Q). The native screen capture is written
//! before the event loop, and the report line is also written to `DF0:gui.txt`
//! so an automated run can read it without a screen scrape. A few one-byte
//! `DF0:gui-*` handshake files let the smoke wait for each transition instead
//! of racing fixed sleeps against the emulated floppy.

module examples.amiga.gui;

import {
    Screen, openScreen, saveScreen, Window, openWindow, closeWindow,
    windowWidth, windowHeight, WindowEvent, waitEvent, pollEvent,
    EVENT_NONE, EVENT_CLOSE, EVENT_GADGET, EVENT_MENU,
    addButton, addString, windowString, addMenu, addMenuItemKey,
    activateGadget, askYesNo, setPointer
} from std.amiga.intuition;
import {
    setColor, clear, fill, windowClear, windowFill, windowDraw
} from std.amiga.graphics;
import { Font, openFont, defaultFont, drawText, windowText } from std.amiga.text;
import { String, stringOf, toCString, bytes } from std.text;
import { slice } from std.mem;
import { File, createFile, writeBytes, println } from std.io;

/// Counts collected by the demo and reported in the acceptance line.
struct GuiResult {
    ok: bool;
    win: i32;
    gad: i32;
    menu: i32;
    chars: i32;
    req: i32;
    stage: i32;
}

/// The failure result: no line counts are reported.
func failedAt(stage: i32): GuiResult {
    return GuiResult {
        ok: false,
        win: 0,
        gad: 0,
        menu: 0,
        chars: 0,
        req: 0,
        stage: stage,
    };
}

/// Write a one-byte handshake file for the automated A500 smoke.
///
/// The emulated floppy is shared with the host as an ADF, so the smoke can poll
/// the raw image for these names. The names are unique and are built from a
/// prefix plus `name`, so they do not appear as contiguous literals in the
/// program image.
func mark(name: str): void {
    let path: String = $"DF0:gui-{name}";
    let file: File? = createFile(toCString(path));
    if (file != null) {
        let one: u8[1] = [1];
        writeBytes(file, slice(one, 0, 1));
    }
}

/// Draw the status panel along the bottom of the window.
func drawStatus(borrow window: Window, borrow font: Font, const text: u8[]): void {
    let width: i32 = windowWidth(window);
    let height: i32 = windowHeight(window);
    windowFill(window, 12, height - 32, width - 12, height - 10, 6);
    windowDraw(window, 12, height - 32, width - 12, height - 32, 5);
    windowDraw(window, 12, height - 10, width - 12, height - 10, 5);
    windowText(window, font, 20, height - 23, 3, text);
}

/// Draw the screen footer that stays visible below the window.
func drawFooter(borrow screen: Screen, borrow font: Font): void {
    fill(screen, 0, 240, 639, 255, 1);
    drawText(screen, font, 16, 252, 4, bytes(stringOf("Clorraine GUI demo")));
    drawText(screen, font, 430, 252, 4,
             bytes(stringOf("640x256  |  8 colours")));
}

/// Build and run the demo, returning its counts.
func runGui(): GuiResult {
    let screenTitle: String = stringOf("Clorraine");
    let screen: Screen? = openScreen(640, 256, 3, toCString(screenTitle));
    if (screen == null) {
        return failedAt(1);
    }

    /* A light eight-colour palette: 0 desktop, 1 ink, 2 accent, 3 success,
     * 4 paper, 5 muted, 6 panel, 7 white. */
    setColor(screen, 0, 150, 165, 190);
    setColor(screen, 1, 20, 30, 50);
    setColor(screen, 2, 240, 130, 20);
    setColor(screen, 3, 0, 140, 70);
    setColor(screen, 4, 252, 252, 250);
    setColor(screen, 5, 80, 110, 160);
    setColor(screen, 6, 226, 231, 240);
    setColor(screen, 7, 255, 255, 255);
    setColor(screen, 17, 255, 255, 255);
    setColor(screen, 18, 0, 0, 0);
    clear(screen, 0);

    let badWindow: Window? = openWindow(screen, -1, 0, 100, 100,
                                        toCString(stringOf("bad")));
    if (badWindow != null) {
        return failedAt(2);
    }

    let window: Window? = openWindow(screen, 32, 32, 576, 208,
                                      toCString(stringOf("Clorraine GUI")));
    if (window == null) {
        return failedAt(3);
    }

    let badButton: bool = addButton(window, 1000, 0, 20, 20,
                                    toCString(stringOf("x")), 1);
    if (badButton) {
        return failedAt(4);
    }
    let badString: bool = addString(window, 0, 0, 20, 20,
                                    toCString(stringOf("x")),
                                    toCString(stringOf("y")), 0, 2);
    if (badString) {
        return failedAt(5);
    }
    let badId: bool = addButton(window, 0, 0, 20, 20,
                                toCString(stringOf("x")), 0);
    if (badId) {
        return failedAt(6);
    }
    let longTitle: String =
        stringOf("0123456789012345678901234567890123456789012345678901234567890123456789");
    let badMenu: i32 = addMenu(window, toCString(longTitle));
    if (badMenu != -1) {
        return failedAt(7);
    }

    let font: Font? = openFont(toCString(stringOf("topaz.font")), 8, 0);
    if (font == null) {
        font = defaultFont();
    }
    if (font == null) {
        return failedAt(8);
    }

    let width: i32 = windowWidth(window);
    let height: i32 = windowHeight(window);
    windowClear(window, 4);
    windowFill(window, 0, 0, 3, height - 1, 2);

    windowText(window, font, 20, 14, 1, bytes(stringOf("Clorraine GUI demo")));
    windowText(window, font, 20, 30, 5, bytes(stringOf("A500 / Kickstart 1.3")));
    windowFill(window, width - 190, 14, width - 20, 38, 6);
    windowDraw(window, width - 190, 14, width - 20, 14, 5);
    windowDraw(window, width - 190, 38, width - 20, 38, 5);
    windowText(window, font, width - 180, 22, 1,
               bytes(stringOf("8 colours - 640x256")));
    windowDraw(window, 20, 50, width - 20, 50, 6);

    windowText(window, font, 20, 68, 1, bytes(stringOf("Name:")));
    let field: bool = addString(window, 72, 62, 320, 20,
                                toCString(stringOf("")),
                                toCString(stringOf("")), 32, 2);
    if (!field) {
        return failedAt(9);
    }
    let button: bool = addButton(window, 20, 94, 150, 24,
                                 toCString(stringOf("Say hello")), 1);
    if (!button) {
        return failedAt(10);
    }
    windowText(window, font, 186, 100, 5,
               bytes(stringOf("Return opens a Yes/No requester")));
    windowDraw(window, 20, 124, width - 20, 124, 6);
    windowText(window, font, 20, 138, 1,
               bytes(stringOf("Command keys (Right Amiga):")));
    windowText(window, font, 20, 152, 5,
               bytes(stringOf("H  Hello        A  About        Q  Quit")));

    let file: i32 = addMenu(window, toCString(stringOf("File")));
    if (file != 0) {
        return failedAt(11);
    }
    let hello: bool = addMenuItemKey(window, file, toCString(stringOf("Hello")),
                                     10, u8(72));
    if (!hello) {
        return failedAt(12);
    }
    let quit: bool = addMenuItemKey(window, file, toCString(stringOf("Quit")),
                                    11, u8(81));
    if (!quit) {
        return failedAt(13);
    }
    let help: i32 = addMenu(window, toCString(stringOf("Help")));
    if (help != 1) {
        return failedAt(14);
    }
    let about: bool = addMenuItemKey(window, help, toCString(stringOf("About")),
                                     20, u8(65));
    if (!about) {
        return failedAt(15);
    }

    drawFooter(screen, font);
    setPointer(window, true);
    drawStatus(window, font, bytes(stringOf("ready")));
    if (!activateGadget(window, 2)) {
        return failedAt(16);
    }
    if (!saveScreen(screen, toCString(stringOf("DF0:gui.cscr")))) {
        return failedAt(17);
    }
    mark("ready");

    let pending: WindowEvent = pollEvent(window);
    while (pending.kind != EVENT_NONE) {
        pending = pollEvent(window);
    }

    let buffer: u8[64] = [; 0];
    let strCount: i32 = 0;
    let reqCount: i32 = 0;
    let running: bool = true;
    while (running) {
        let event: WindowEvent = waitEvent(window);
        if (event.kind == EVENT_CLOSE) {
            running = false;
        } else if (event.kind == EVENT_NONE) {
            running = false;
        } else if (event.kind == EVENT_GADGET) {
            if (event.gadget == 2) {
                strCount = windowString(window, 2, borrow slice(buffer, 0, 64));
            }
            if (event.gadget == 1 || event.gadget == 2) {
                let answer: bool = askYesNo(window,
                                            toCString(stringOf("Continue?")));
                if (answer) {
                    reqCount = reqCount + 1;
                    drawStatus(window, font, bytes(stringOf("yes")));
                } else {
                    drawStatus(window, font, bytes(stringOf("no")));
                }
                mark("answered");
            }
        } else if (event.kind == EVENT_MENU) {
            if (event.menu == 10) {
                drawStatus(window, font, bytes(stringOf("hello")));
                mark("hello");
            } else if (event.menu == 11) {
                mark("quit");
                running = false;
            } else if (event.menu == 20) {
                let aboutAnswer: bool =
                    askYesNo(window, toCString(stringOf("Clorraine GUI / A500")));
                if (aboutAnswer) {
                    reqCount = reqCount + 1;
                }
                drawStatus(window, font, bytes(stringOf("about")));
                mark("about");
            }
        }
    }

    setPointer(window, false);
    closeWindow(window);
    return GuiResult {
        ok: true,
        win: 1,
        gad: 2,
        menu: 2,
        chars: strCount,
        req: reqCount,
        stage: 0,
    };
}

func main(): i32 {
    let result: GuiResult = runGui();
    if (!result.ok) {
        println($"gui: err {result.stage}");
        return 1;
    }
    let line: String =
        $"gui: ok win {result.win} gad {result.gad} menu {result.menu} str {result.chars} req {result.req}";
    println(line);
    {
        let file: File? = createFile(toCString(stringOf("DF0:gui.txt")));
        if (file != null) {
            writeBytes(file, bytes(line));
        }
    }
    return 0;
}
