//! Bundle 9 diskfont acceptance: open the Workbench 1.3.4 diamond font and
//! report its height. The A500 gate mounts the Workbench ADF as DF1.

module examples.amiga.diskfont;

import { Font, openDiskFont, freeFont, textHeight } from std.amiga.text;
import { String, stringOf, toCString } from std.text;
import { println } from std.io;

func main(): i32 {
    let name: String = stringOf("diamond.font");
    let opened: Font? = openDiskFont(toCString(name), 12, 0);
    if (opened == null) {
        println("diskfont: err 1");
        return 1;
    }
    let font: Font = opened;
    let height: i32 = textHeight(font);
    freeFont(font);
    if (height != 12) {
        println("diskfont: err 2");
        return 1;
    }
    println("diskfont: ok h 12");
    return 0;
}
