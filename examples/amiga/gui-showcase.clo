// Clorraine Studio: the native Intuition showcase.
//
// This is deliberately a normal Workbench application, not a custom screen:
// the window opens on the default public screen, and its labels, button, and
// string field are standard GadTools controls. Intuition supplies the frame,
// title bar, palette, font, and gadget look; the program only lays out native
// controls and runs the standard event loop.

module examples.amiga.GuiShowcase;

import {
    Window, openWorkbenchWindow, closeWindow, addMenu, addMenuItemKey,
    WindowEvent, EVENT_CLOSE, EVENT_GADGET, EVENT_MENU, EVENT_NONE
} from std.amiga.intuition;
import {
    GadgetList, newGadgetList, addButton, addText, addString,
    buildGadgets, freeGadgetList, gadgetWaitEvent
} from std.amiga.gadtools;
import { String, stringOf, toCString } from std.text;
import { savePublicScreen } from std.amiga.workbench;
import { delayTicks } from std.amiga.dos;
import { println } from std.io;

func main(): i32 {
    // Workbench may still be finishing its first screen paint after the ROM
    // startup fixture returns. Give it a moment before locking the screen.
    delayTicks(u32(50));

    let title: String = stringOf("Clorraine Studio");
    let windowMaybe: Window? =
        openWorkbenchWindow(80, 40, 420, 190, toCString(title));
    if (windowMaybe == null) {
        println("gui-showcase: no Workbench screen");
        return 1;
    }
    let window: Window = windowMaybe;

    let fontName: String = stringOf("topaz.font");
    let listMaybe: GadgetList? = newGadgetList(window, toCString(fontName), 8);
    if (listMaybe == null) {
        println("gui-showcase: gadget list failed");
        closeWindow(window);
        return 2;
    }
    let list: GadgetList = listMaybe;

    let heading: String = stringOf("Clorraine Studio");
    let machine: String = stringOf("Native Intuition / Kickstart 3.1");
    let note: String = stringOf("Standard GadTools controls on Workbench.");
    let initial: String = stringOf("examples/amiga/prism.clo");
    let buildLabel: String = stringOf("Build");
    let quitLabel: String = stringOf("Quit");

    if (!addText(list, 1, toCString(heading), 16, 14, 300, 12) ||
        !addText(list, 2, toCString(machine), 16, 34, 320, 12) ||
        !addText(list, 3, toCString(note), 16, 50, 380, 12) ||
        !addString(list, 4, toCString(initial), 64, 16, 70, 380, 18) ||
        !addButton(list, 5, toCString(buildLabel), 16, 108, 90, 20) ||
        !addButton(list, 6, toCString(quitLabel), 116, 108, 90, 20)) {
        println("gui-showcase: gadget failed");
        freeGadgetList(list);
        closeWindow(window);
        return 3;
    }
    if (!buildGadgets(list)) {
        println("gui-showcase: build failed");
        freeGadgetList(list);
        closeWindow(window);
        return 3;
    }

    let project: i32 = addMenu(window, toCString(stringOf("Project")));
    if (project == 0) {
        let buildMenu: String = stringOf("Build");
        let quitMenu: String = stringOf("Quit");
        if (!addMenuItemKey(window, project, toCString(buildMenu), 10, u8(66)) ||
            !addMenuItemKey(window, project, toCString(quitMenu), 11, u8(81))) {
            println("gui-showcase: menu failed");
        }
    }

    // Native capture of the real Workbench screen, including the window and
    // its standard gadgets. The file is read back by the visual gate.
    delayTicks(u32(25));
    let workbench: String = stringOf("Workbench");
    let capturePath: String = stringOf("CNEXT:gui31.cscr");
    if (!savePublicScreen(toCString(workbench), toCString(capturePath))) {
        println("gui-showcase: capture failed");
    }
    println("gui-showcase: ready");

    let running: bool = true;
    while (running) {
        let event: WindowEvent = gadgetWaitEvent(window);
        if (event.kind == EVENT_CLOSE || event.kind == EVENT_NONE) {
            running = false;
        } else if (event.kind == EVENT_MENU && event.menu == 11) {
            running = false;
        } else if (event.kind == EVENT_GADGET && event.gadget == 6) {
            running = false;
        } else if (event.kind == EVENT_GADGET && event.gadget == 5) {
            println("gui-showcase: build");
        }
    }

    freeGadgetList(list);
    closeWindow(window);
    return 0;
}
