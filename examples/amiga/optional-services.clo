//! Bundle 9 Workbench services acceptance: commodities, locale, ARexx,
//! clipboard, serial/parallel/printer.
//!
//! The A600/KS2.05 gate boots a clean HD and checks one file per surface. The
//! clipboard and device sections prove open/write or open/close; the API
//! remains typed and bounded.

module examples.amiga.optional_services;

import { MsgPort, createMsgPort, deleteMsgPort } from std.amiga.exec;
import { Commodity, openCommodity, closeCommodity }
    from std.amiga.commodities;
import { Locale, openLocale, closeLocale, localeLanguageName,
         localeCountryCode, localeGmtOffset, localeDateTimeFormat }
    from std.amiga.locale;
import { RexxMessage, createRexxMessage, setRexxAction, setRexxArg,
         sendRexxMessage, receiveRexxMessage, replyRexxMessage,
         reclaimRexxMessage, rexxMessageAction, rexxMessageArg }
    from std.amiga.arexx;
import { Clipboard, openClipboard, closeClipboard, clipboardWrite }
    from std.amiga.clipboard;
import { Serial, Parallel, Printer, openSerial, closeSerial,
         openParallel, closeParallel, openPrinter, closePrinter }
    from std.amiga.devices;
import { String, stringOf, toCString, bytes } from std.text;
import { slice } from std.mem;
import { File, createFile, writeBytes } from std.io;
import { println } from std.io;

func writeLine(path: cstring, text: String): void {
    let file: File? = createFile(path);
    if (file != null) {
        writeBytes(file, bytes(text));
    }
}

func mark(name: cstring): void {
    let file: File? = createFile(name);
    if (file != null) {
        let data: u8[1] = [120; 1];
        writeBytes(file, slice(data, 0, 1));
    }
}

func main(): i32 {
    mark(toCString(stringOf("CNEXT:svc-start.txt")));
    let name: String = stringOf("Bundle9");
    let portCreated: MsgPort? = createMsgPort();
    if (portCreated == null) {
        println("cmd: err 1");
        return 1;
    }
    let port: MsgPort = portCreated;
    mark(toCString(stringOf("CNEXT:svc-port.txt")));
    let firstCreated: Commodity? =
        openCommodity(toCString(name), toCString(name), toCString(name),
                      port, true, 0);
    if (firstCreated == null) {
        deleteMsgPort(port);
        println("cmd: err 2");
        return 1;
    }
    let first: Commodity = firstCreated;
    mark(toCString(stringOf("CNEXT:svc-commodity.txt")));
    let duplicate: Commodity? =
        openCommodity(toCString(name), toCString(name), toCString(name),
                      port, true, 0);
    let duplicateFailed: bool = duplicate == null;
    closeCommodity(first);
    let secondCreated: Commodity? =
        openCommodity(toCString(name), toCString(name), toCString(name),
                      port, true, 0);
    if (secondCreated == null) {
        deleteMsgPort(port);
        println("cmd: err 3");
        return 1;
    }
    let second: Commodity = secondCreated;
    closeCommodity(second);
    deleteMsgPort(port);
    if (!duplicateFailed) {
        println("cmd: err 4");
        return 1;
    }
    writeLine(toCString(stringOf("CNEXT:svc-cmd.txt")), stringOf("cmd: ok broker 1 dup 1 reopen 1"));

    let empty: String = stringOf("");
    let localeCreated: Locale? = openLocale(toCString(empty));
    if (localeCreated == null) {
        println("locale: err 1");
        return 1;
    }
    let locale: Locale = localeCreated;
    let language: String? = localeLanguageName(locale);
    let country: u32 = localeCountryCode(locale);
    let gmt: i32 = localeGmtOffset(locale);
    let pattern: String? = localeDateTimeFormat(locale);
    closeLocale(locale);
    if (language == null || country == 0 || pattern == null ||
        gmt < -1000 || gmt > 1000) {
        println("locale: err 2");
        return 1;
    }
    writeLine(toCString(stringOf("CNEXT:svc-locale.txt")), stringOf("locale: ok name 1 cc 1 gmt 1 fmt 1"));

    let appPortCreated: MsgPort? = createMsgPort();
    let replyPortCreated: MsgPort? = createMsgPort();
    if (appPortCreated == null || replyPortCreated == null) {
        println("rexx: err 1");
        return 1;
    }
    let appPort: MsgPort = appPortCreated;
    let replyPort: MsgPort = replyPortCreated;
    let extension: String = stringOf("");
    let host: String = stringOf("");
    let messageCreated: RexxMessage? =
        createRexxMessage(replyPort, toCString(extension), toCString(host));
    if (messageCreated == null) {
        println("rexx: err 2");
        return 1;
    }
    let message: RexxMessage = messageCreated;
    if (!setRexxAction(message, 1)) {
        println("rexx: err 3");
        return 1;
    }
    if (!setRexxArg(message, 0, toCString(name))) {
        println("rexx: err 4");
        return 1;
    }
    sendRexxMessage(appPort, message);
    let receivedCreated: RexxMessage? = receiveRexxMessage(appPort);
    if (receivedCreated == null) {
        println("rexx: err 5");
        return 1;
    }
    let received: RexxMessage = receivedCreated;
    let action: i32 = rexxMessageAction(received);
    let argument: u8[32] = [0; 32];
    let argumentLength: i32 = rexxMessageArg(received, 0, slice(argument, 0, 32));
    replyRexxMessage(received);
    let returnedCreated: RexxMessage? = receiveRexxMessage(replyPort);
    if (returnedCreated == null) {
        println("rexx: err 6");
        return 1;
    }
    let returned: RexxMessage = returnedCreated;
    reclaimRexxMessage(returned);
    mark(toCString(stringOf("CNEXT:svc-rexx-reclaimed.txt")));
    deleteMsgPort(replyPort);
    mark(toCString(stringOf("CNEXT:svc-rexx-replyport.txt")));
    deleteMsgPort(appPort);
    mark(toCString(stringOf("CNEXT:svc-rexx-appport.txt")));
    if (action != 1 || argumentLength != 7) {
        println("rexx: err 7");
        return 1;
    }
    writeLine(toCString(stringOf("CNEXT:svc-rexx.txt")), stringOf("rexx: ok action 1"));

    mark(toCString(stringOf("CNEXT:svc-clip-start.txt")));
    let clipboardCreated: Clipboard? = openClipboard(0);
    if (clipboardCreated == null) {
        println("clip: err 1");
        return 1;
    }
    let clipboard: Clipboard = clipboardCreated;
    mark(toCString(stringOf("CNEXT:svc-clip-open.txt")));
    let clipData: u8[4] = [99, 108, 105, 112];
    if (!clipboardWrite(clipboard, slice(clipData, 0, 4))) {
        println("clip: err 2");
        return 1;
    }
    closeClipboard(clipboard);
    writeLine(toCString(stringOf("CNEXT:svc-clip.txt")), stringOf("clip: ok n 4"));

    mark(toCString(stringOf("CNEXT:svc-ser-start.txt")));
    let serialCreated: Serial? = openSerial(0, 9600);
    if (serialCreated == null) {
        println("ser: err 1");
        return 1;
    }
    let serial: Serial = serialCreated;
    closeSerial(serial);
    writeLine(toCString(stringOf("CNEXT:svc-ser.txt")), stringOf("ser: ok open 1"));

    mark(toCString(stringOf("CNEXT:svc-par-start.txt")));
    let parallelCreated: Parallel? = openParallel(0, 0);
    if (parallelCreated == null) {
        println("par: err 1");
        return 1;
    }
    let parallel: Parallel = parallelCreated;
    closeParallel(parallel);
    writeLine(toCString(stringOf("CNEXT:svc-par.txt")), stringOf("par: ok open 1"));

    mark(toCString(stringOf("CNEXT:svc-prt-start.txt")));
    let printerCreated: Printer? = openPrinter(0);
    if (printerCreated == null) {
        println("prt: err 1");
        return 1;
    }
    let printer: Printer = printerCreated;
    closePrinter(printer);
    writeLine(toCString(stringOf("CNEXT:svc-prt.txt")), stringOf("prt: ok open 1"));
    return 0;
}
