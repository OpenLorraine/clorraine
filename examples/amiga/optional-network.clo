//! Bundle 9 network acceptance: connect to the host echo server, send five
//! bytes, and receive them back.
//!
//! The A1200/KS3.1 gate runs FS-UAE with `--bsdsocket_library=1` and
//! `--network host`, and a host echo server on 127.0.0.1:12345. The one-shot
//! `tcpEcho` helper keeps socket/connect/send/receive in one shim call.

module examples.amiga.optional_network;

import { tcpEcho } from std.amiga.bsdsocket;
import { String, stringOf, toCString, bytes } from std.text;
import { slice } from std.mem;
import { println } from std.io;

func main(): i32 {
    let host: String = stringOf("127.0.0.1");
    let payload: String = stringOf("ping\n");
    let request: u8[] = bytes(payload);
    let response: u8[8] = [0; 8];
    let received: i32 = tcpEcho(toCString(host), 12345, request,
                               slice(response, 0, 8));
    if (received != 5) {
        println($"net: err 3 recv {received}");
        return 1;
    }
    if (response[0] != 112 || response[3] != 103) {
        println("net: err 5");
        return 1;
    }
    println("net: ok send 5 recv 5");
    return 0;
}
