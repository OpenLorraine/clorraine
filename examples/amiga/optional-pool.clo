//! Bundle 9 utility-pool acceptance: allocate, write, read, and refcounted
//! release. The gate redirects standard output.

module examples.amiga.optional_pool;

import { UtilityPool, UtilityBlock, createUtilityPool, allocUtilityBlock,
         writeUtilityBlock, readUtilityBlock, freeUtilityBlock,
         freeUtilityPool } from std.amiga.pool;
import { slice } from std.mem;
import { println } from std.io;

func main(): i32 {
    let poolCreated: UtilityPool? = createUtilityPool(0, 1024, 1024);
    if (poolCreated == null) {
        println("pool: err 1");
        return 1;
    }
    let pool: UtilityPool = poolCreated;
    let blockCreated: UtilityBlock? = allocUtilityBlock(pool, 8);
    if (blockCreated == null) {
        freeUtilityPool(pool);
        println("pool: err 2");
        return 1;
    }
    let block: UtilityBlock = blockCreated;
    let bytes: u8[4] = [1, 2, 3, 4];
    if (!writeUtilityBlock(block, slice(bytes, 0, 4))) {
        freeUtilityBlock(block);
        freeUtilityPool(pool);
        println("pool: err 3");
        return 1;
    }
    let out: u8[8] = [0; 8];
    let read: i32 = readUtilityBlock(block, slice(out, 0, 8));
    /* Drop the pool first; the refcount keeps it alive until the block. */
    freeUtilityPool(pool);
    freeUtilityBlock(block);
    if (read != 4 || out[0] != 1 || out[3] != 4) {
        println("pool: err 4");
        return 1;
    }
    println("pool: ok 1");
    return 0;
}
