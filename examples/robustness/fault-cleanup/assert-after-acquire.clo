// Fault-exit cleanup probe: a DOS lock is live when an assertion fails. The
// failed assertion still skips every drop, but the runtime must release the
// lock at exit.
module robustness.fault_cleanup.assert_after_acquire;

import { Lock, lockPath } from std.amiga.dos;

func main(): i32 {
    let lock: Lock? = lockPath("");
    if (lock == null) {
        return 1;
    }
    let ok: bool = false;
    assert(ok, "the lock probe must fault here");   // error E11213: assertion failed
    return 0;
}
