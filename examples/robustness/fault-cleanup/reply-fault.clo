// Fault-exit cleanup probe: a message the program created was delivered to
// its own port, fetched, and replied, so the reply now waits on the program's
// own reply port. An index goes out of range before the reply is fetched; the
// runtime must still free the replied message along with both ports.
module robustness.fault_cleanup.reply_fault;

import { MsgPort, NewMessage, Message, createMsgPort, createMessage, putMsg, getMsg, replyMsg } from std.amiga.exec;

func main(): i32 {
    let reply_opt: MsgPort? = createMsgPort();
    if (reply_opt == null) {
        return 1;
    }
    let reply: MsgPort = reply_opt;
    let dest_opt: MsgPort? = createMsgPort();
    if (dest_opt == null) {
        return 2;
    }
    let dest: MsgPort = dest_opt;
    let message_opt: NewMessage? = createMessage(reply, 7);
    if (message_opt == null) {
        return 3;
    }
    let message: NewMessage = message_opt;
    putMsg(dest, message);
    let fetched_opt: Message? = getMsg(dest);
    if (fetched_opt == null) {
        return 4;
    }
    let fetched: Message = fetched_opt;
    replyMsg(fetched);
    let xs: u32[2] = [1, 2];
    let i: usize = 5;
    return i32(xs[i]);   // error E11211: index out of range
}
