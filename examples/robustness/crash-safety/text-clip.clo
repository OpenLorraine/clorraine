// Crash-safety probe for Kickstart 1.3: text partly outside the screen is
// clipped at the screen's edge. A reference copy of the text is drawn fully
// inside the screen; six more copies run off the left, right, top, and bottom
// edges and two corners. The gate compares the visible part of each clipped
// copy with the same part of the reference, so the clipped text must look
// exactly as it would on a larger screen. Text far outside the screen draws
// nothing, and the temporary raster the clip uses must be freed: the gate also
// checks that free chip memory comes back. The screen is saved to DF1: for
// the comparison.
module robustness.crash_safety.text_clip;

import { Screen, openScreen, saveScreen } from std.amiga.intuition;
import { clear } from std.amiga.graphics;
import { Font, defaultFont, drawText, textWidth, textHeight } from std.amiga.text;
import { String, stringOf, bytes } from std.text;
import { println } from std.io;

func main(): i32 {
    let opened: Screen? = openScreen(320, 200, 2, "Clip probe");
    if (opened == null) {
        println("textclip: err screen");
        return 1;
    }
    let screen: Screen = opened;
    clear(screen, 2);
    let found: Font? = defaultFont();
    if (found == null) {
        println("textclip: err font");
        return 1;
    }
    let font: Font = found;
    let text: String = stringOf("CLIP");

    // The reference, then the clipped copies.
    drawText(screen, font, 140, 100, 1, bytes(text));
    drawText(screen, font, -13, 50, 1, bytes(text));
    drawText(screen, font, 300, 70, 1, bytes(text));
    drawText(screen, font, 140, 2, 1, bytes(text));
    drawText(screen, font, 140, 202, 1, bytes(text));
    drawText(screen, font, -20, 3, 1, bytes(text));
    drawText(screen, font, 305, 203, 1, bytes(text));

    // Text far outside the screen.
    let i: i32 = 0;
    while (i < 200) {
        drawText(screen, font, 1000, -4000 + i * 40, 1, bytes(text));
        drawText(screen, font, -1000, -4000 + i * 40, 1, bytes(text));
        i = i + 1;
    }
    drawText(screen, font, 100000, 50, 1, bytes(text));
    drawText(screen, font, 50, -100000, 1, bytes(text));

    if (!saveScreen(screen, "DF1:text.cscr")) {
        println("textclip: err save");
        return 1;
    }
    let width: i32 = textWidth(font, bytes(text));
    let height: i32 = textHeight(font);
    println($"textclip: ok w {width} h {height}");
    return 0;
}
