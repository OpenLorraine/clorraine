// A runtime fault from a pure fill's division guard. The host suite covers
// the same shape under AddressSanitizer and UBSan; this program is the
// target-side parity probe for `run-fault-amiga.sh`.
module robustness.FillDivisor;

func main(): i32 {
    let d: u8 = 0;
    let a: u8[4] = [; u8(10) / d];
    return i32(a[0]);
}
