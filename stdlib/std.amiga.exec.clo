//! Amiga Exec: tasks, private message ports, messages, and signals.
//!
//! This module belongs to the hosted-Amiga profiles; the host and freestanding
//! profiles have no AmigaOS scheduler, so the module is not available there.
//! The wrappers reach the profile C shim through `ffi`, so application code
//! never writes `ffi` and never touches `unsafe`. The surface is the classic
//! Kickstart 1.3 Exec API: private and public ports (`CreatePort`), tasks,
//! libraries, and devices.
//!
//! The message surface is deliberately small: private and public message ports,
//! one message with a reply port and an integer payload, and the operations an
//! event loop needs. A message is move-only. `putMsg` consumes the sent
//! message, `getMsg` returns an owned message, and `replyMsg` consumes it. A
//! fetched message that will not be replied is released with `releaseMsg`; an
//! unsent `NewMessage` is released by its generated drop or with
//! `freeMessage`.
//!
//! `signals(port)` returns the port's signal mask. `waitSignals(mask)` sleeps
//! until any bit in the mask arrives and returns the bits that did. The caller
//! must loop when several sources share one wait.
//!
//! A `Task` is a plain Exec worker at priority -1. Its entry is a capture-less
//! `func(): void` that must use only arithmetic, module-level scalars, and
//! `reportTaskResult`; it must not call DOS, Intuition, `std.io`, allocate,
//! drop an owning value, or block. `joinTask` waits for the worker, removes it,
//! and returns its result. The generated drop joins an unjoined task.

module std.amiga.exec;

import { Window } from std.amiga.intuition;

/// A private message port. The generated drop deletes it.
///
/// The caller must drain the port before the drop runs; a queued message would
/// otherwise be lost.
export handle MsgPort freedBy cl_delete_msg_port;

/// A message created by this module that has not been sent yet.
///
/// The generated drop releases it, so an unsent message cannot leak or be
/// queued by accident. Once `putMsg` accepts it, the port owns it.
export handle NewMessage freedBy cl_free_message;

/// A message fetched from a port.
///
/// The generated drop replies it, matching the exec ownership rule. A message
/// that has returned through its reply port is released with `releaseMsg`
/// instead of being replied a second time.
export handle Message freedBy cl_reply_msg;

/// An owned worker task. The generated drop joins it if the caller did not.
///
/// The task runs at priority -1 and uses a stack of 4096..65536 bytes. It is a
/// plain Exec task, not a DOS process; see the module notes for the entry
/// restrictions. `joinTask` consumes the handle; an unjoined handle is joined
/// and removed at scope end.
export handle Task freedBy cl_task_free;

/// An open AmigaOS library. The generated drop closes it.
///
/// The handle is the library base; opening version 0 accepts any version and a
/// version above the installed library returns `null`.
export handle Library freedBy cl_close_library;

/// An open Exec device with one owned `IOStdReq` and a reply port.
///
/// The generic request is the standard `IOStdReq`; devices with a larger
/// request (timer, audio) keep their typed modules. The generated drop aborts a
/// pending request, waits for it, and closes the device.
export handle Device freedBy cl_close_device;

/// Generic Exec device commands from `exec/io.h`.
export const CMD_INVALID: u16 = 0;
export const CMD_RESET: u16 = 1;
export const CMD_READ: u16 = 2;
export const CMD_WRITE: u16 = 3;
export const CMD_UPDATE: u16 = 4;
export const CMD_CLEAR: u16 = 5;
export const CMD_STOP: u16 = 6;
export const CMD_START: u16 = 7;
export const CMD_FLUSH: u16 = 8;

ffi stdexec {
    func cl_create_msg_port(): MsgPort?;
    func cl_create_public_port(name: cstring): MsgPort?;
    func cl_delete_msg_port(take port: MsgPort): void;
    func cl_create_message(borrow reply: MsgPort, payload: i32): NewMessage?;
    func cl_message_payload(borrow msg: Message): i32;
    func cl_put_msg(borrow port: MsgPort, take msg: NewMessage): void;
    func cl_signals(borrow port: MsgPort): u32;
    func cl_wait_signals(mask: u32): u32;
    func cl_get_msg(borrow port: MsgPort): Message?;
    func cl_reply_msg(take msg: Message): void;
    func cl_free_message(take msg: NewMessage): void;
    func cl_release_message(take msg: Message): void;
    func cl_create_task(entry: func(): void, stack_size: u32): Task?;
    func cl_task_result(value: i32): void;
    func cl_join_task(take task: Task): i32;
    func cl_task_free(take task: Task): void;
    func cl_open_library(name: cstring, version: u16): Library?;
    func cl_close_library(take library: Library): void;
    func cl_library_version(borrow library: Library): u16;
    func cl_library_revision(borrow library: Library): u16;
    func cl_open_device(name: cstring, unit: i32, flags: u32): Device?;
    func cl_open_console(borrow window: Window, unit: u8): Device?;
    func cl_close_device(take device: Device): void;
    func cl_device_command(borrow device: Device, command: u16): bool;
    func cl_device_set_buffer(borrow device: Device, length: u32): bool;
    func cl_device_write_buffer(borrow device: Device, data: raw u8,
                                length: u32): bool;
    func cl_device_set_offset(borrow device: Device, offset: u32): bool;
    func cl_device_do_io(borrow device: Device, data: raw u8,
                         length: u32): i32;
    func cl_device_send_io(borrow device: Device): bool;
    func cl_device_wait_io(borrow device: Device, data: raw u8,
                           length: u32): i32;
    func cl_device_check_io(borrow device: Device, data: raw u8,
                            length: u32): bool;
    func cl_device_abort_io(borrow device: Device): void;
    func cl_device_actual(borrow device: Device): u32;
    func cl_device_error(borrow device: Device): i32;
}

/// Creates a private message port, or returns `null` when the system is out of
/// signals or memory.
export func createMsgPort(): MsgPort? {
    return cl_create_msg_port();
}

/// Creates a public named message port, or returns `null` for an empty name or
/// an allocation failure.
///
/// `CreatePort` stores the name pointer rather than copying it, so the name
/// must stay alive until the port is deleted. A public port can be found by
/// another program with `FindPort`. The name must be non-empty and unique.
export func createPublicPort(name: cstring): MsgPort? {
    return cl_create_public_port(name);
}

/// Deletes a message port.
///
/// The port must be empty; the acceptance programs drain it before deleting.
export func deleteMsgPort(take port: MsgPort): void {
    cl_delete_msg_port(port);
}

/// Allocates a message with `reply` as its reply port and `payload` as its
/// integer body. Returns `null` on allocation failure.
///
/// The reply port is borrowed, not moved: the caller keeps it for the reply
/// wait and deletes it after the message is released.
export func createMessage(borrow reply: MsgPort, payload: i32): NewMessage? {
    return cl_create_message(reply, payload);
}

/// Reads the integer payload of a fetched message.
export func messagePayload(borrow msg: Message): i32 {
    return cl_message_payload(msg);
}

/// Queues `msg` on `port` and wakes the port owner.
///
/// The message is moved into the queue; the caller's binding is no longer
/// valid. The message becomes owned by the receiver, then by the reply path.
export func putMsg(borrow port: MsgPort, take msg: NewMessage): void {
    cl_put_msg(port, msg);
}

/// Returns the signal mask that wakes the owner of `port`.
export func signals(borrow port: MsgPort): u32 {
    return cl_signals(port);
}

/// Waits until any signal in `mask` arrives and returns the received bits.
///
/// A caller that waits on more than one source checks the returned mask before
/// draining a port; an unrelated signal can wake the wait.
export func waitSignals(mask: u32): u32 {
    return cl_wait_signals(mask);
}

/// Takes the next message from `port`, or returns `null` when the queue is
/// empty.
export func getMsg(borrow port: MsgPort): Message? {
    return cl_get_msg(port);
}

/// Replies `msg` to its reply port.
///
/// The message is moved; the caller's binding is no longer valid. The reply
/// port is required: a message created without one is not replyable.
export func replyMsg(take msg: Message): void {
    cl_reply_msg(msg);
}

/// Releases an unsent message explicitly.
///
/// The generated drop already does this; the explicit call is useful when the
/// caller wants the release to happen before the end of the scope.
export func freeMessage(take msg: NewMessage): void {
    cl_free_message(msg);
}

/// Releases a fetched message that this program created and will not reply.
///
/// Use this for a reply copy that has returned, or for a fetched message on a
/// failure path. Do not call it on a message another task still owns, and do
/// not reply the message afterwards.
export func releaseMsg(take msg: Message): void {
    cl_release_message(msg);
}

/// Starts a capture-less worker task and returns an owned handle.
///
/// `stackBytes` is 4096..65536. The worker runs at priority -1, so the parent
/// finishes its own setup before the worker runs. The entry must use only
/// arithmetic, module-level scalars, and `reportTaskResult`; it must not call
/// DOS, Intuition, `std.io`, allocate, drop an owning value, or block. The
/// worker returns its value with `reportTaskResult` and then returns normally.
///
/// Returns `null` when the entry is null, the stack size is out of range, or
/// the task, signal, or record cannot be allocated.
export func createTask(entry: func(): void, stackBytes: u32): Task? {
    return cl_create_task(entry, stackBytes);
}

/// Stores the current worker's result for the parent's `joinTask`.
///
/// This is a no-op outside a task created by `createTask`. The value is copied
/// by the shim; it owns nothing.
export func reportTaskResult(value: i32): void {
    cl_task_result(value);
}

/// Waits for a worker, removes it, and returns the result it reported.
///
/// The handle is consumed. The worker must terminate; there is no
/// cancellation. A task the caller never joins is joined and removed by its
/// generated drop.
export func joinTask(take task: Task): i32 {
    return cl_join_task(task);
}

/// Opens a library at or above `version`, or returns `null`.
///
/// A version of 0 opens any installed version; a version above the installed
/// library returns `null`. The handle is closed by `closeLibrary` or the
/// generated drop.
export func openLibrary(name: cstring, version: u16): Library? {
    return cl_open_library(name, version);
}

/// Closes a library exactly once.
export func closeLibrary(take library: Library): void {
    cl_close_library(library);
}

/// Returns the library's major version, or 0 for a null handle.
export func libraryVersion(borrow library: Library): u16 {
    return cl_library_version(library);
}

/// Returns the library's minor revision, or 0 for a null handle.
export func libraryRevision(borrow library: Library): u16 {
    return cl_library_revision(library);
}

/// Opens an Exec device with one owned `IOStdReq`, or returns `null`.
///
/// `unit` is 0..255; `flags` is passed to `OpenDevice`. The generic request is
/// the standard `IOStdReq`. Use `openConsole` for `console.device`, which needs
/// a caller-supplied Intuition window.
export func openDevice(name: cstring, unit: i32, flags: u32): Device? {
    return cl_open_device(name, unit, flags);
}

/// Opens `console.device` on an open Intuition window, or returns `null`.
///
/// The console device is bound to the window; the window must stay open until
/// `closeDevice` returns. `unit` is 0..255.
export func openConsole(borrow window: Window, unit: u8): Device? {
    return cl_open_console(window, unit);
}

/// Aborts a pending request, waits for it, and closes the device.
export func closeDevice(take device: Device): void {
    cl_close_device(device);
}

/// Sets the request command. Returns false for a null handle or a pending
/// request; the request is left unchanged in that case.
export func deviceCommand(borrow device: Device, command: u16): bool {
    return cl_device_command(device, command);
}

/// Reserves a device-owned buffer of `length` bytes for asynchronous I/O.
///
/// The buffer is allocated in public memory and freed when the device closes
/// or another length is reserved. `length` 0 releases the buffer. Returns
/// false for a null handle, a pending request, or allocation failure.
export func deviceSetBuffer(borrow device: Device, length: u32): bool {
    return cl_device_set_buffer(device, length);
}

/// Copies `data` into the device-owned asynchronous buffer.
///
/// Returns false for a null handle, a pending request, no reserved buffer, or a
/// source longer than the reserved buffer. Use this before `deviceSendIO` for
/// an asynchronous write.
export func deviceWriteBuffer(borrow device: Device, borrow data: u8[]): bool {
    unsafe {
        return cl_device_write_buffer(device, raw u8(data.ptr), u32(len(data)));
    }
}

/// Sets the request offset. Returns false for a null handle or a pending
/// request. The offset unit is device-specific.
export func deviceSetOffset(borrow device: Device, offset: u32): bool {
    return cl_device_set_offset(device, offset);
}

/// Runs a synchronous request over the caller's buffer and returns its error.
///
/// The buffer is borrowed for the call, so it stays alive until the device
/// finishes; a synchronous read writes into it directly. A pending request
/// returns -1 without sending.
export func deviceDoIO(borrow device: Device, borrow data: u8[]): i32 {
    unsafe {
        return cl_device_do_io(device, raw u8(data.ptr), u32(len(data)));
    }
}

/// Starts an asynchronous request. Returns false for a null handle or a
/// request that is already pending.
export func deviceSendIO(borrow device: Device): bool {
    return cl_device_send_io(device);
}

/// Waits for a pending asynchronous request and returns its error.
///
/// When the request was pending, up to `len(data)` bytes of the result are
/// copied from the device-owned buffer into `data`; the copy is bounded by
/// `io_Actual`. On an idle handle it returns the last error without copying; a
/// null handle returns -1.
export func deviceWaitIO(borrow device: Device, borrow data: u8[]): i32 {
    unsafe {
        return cl_device_wait_io(device, raw u8(data.ptr), u32(len(data)));
    }
}

/// Reports whether a pending asynchronous request has completed.
///
/// A completed request is reaped with `WaitIO`, its result is copied into
/// `data`, and the pending state is cleared; the call returns true. An idle or
/// incomplete request returns false.
export func deviceCheckIO(borrow device: Device, borrow data: u8[]): bool {
    unsafe {
        return cl_device_check_io(device, raw u8(data.ptr), u32(len(data)));
    }
}

/// Requests an abort for a pending request. The caller reaps it with
/// `deviceWaitIO`; `closeDevice` does this automatically.
export func deviceAbortIO(borrow device: Device): void {
    cl_device_abort_io(device);
}

/// Returns the number of bytes transferred by the last request.
export func deviceActual(borrow device: Device): u32 {
    return cl_device_actual(device);
}

/// Returns the last request error, or -1 for a null handle.
export func deviceError(borrow device: Device): i32 {
    return cl_device_error(device);
}
