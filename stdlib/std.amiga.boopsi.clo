//! Amiga BOOPSI string-gadget objects (Kickstart 2.0+).
//!
//! This module belongs to `hosted-amiga`; the host, `hosted-amiga-13`, and
//! freestanding profiles reject it with `E11200`. A `BoopsiObject` owns one
//! native Intuition `strgclass` object: create it, attach it to a window, set
//! and read its integer value, then detach and dispose it. The object retains
//! the window, so either drop order is safe. The class is built into Intuition,
//! so no disk class file is loaded.

module std.amiga.boopsi;

import { Window } from std.amiga.intuition;

/// A BOOPSI string-gadget object. The generated drop disposes it.
export handle BoopsiObject freedBy cl_boopsi_dispose;

ffi stdboopsi {
    func cl_boopsi_new_string(borrow window: Window, id: i32, x: i32,
                              y: i32, width: i32, height: i32,
                              initial: i32): BoopsiObject?;
    func cl_boopsi_attach(borrow object: BoopsiObject,
                          borrow window: Window): bool;
    func cl_boopsi_detach(borrow object: BoopsiObject): void;
    func cl_boopsi_set_value(borrow object: BoopsiObject,
                             value: i32): bool;
    func cl_boopsi_value(borrow object: BoopsiObject): i32;
    func cl_boopsi_dispose(take object: BoopsiObject): void;
}

/// Creates an integer string gadget on `window`, or returns null.
///
/// `id` is 1..65535. The object is created with `initial` as its value and is
/// attached separately with `attachObject`.
export func newStringGadget(borrow window: Window, id: i32, x: i32, y: i32,
                            width: i32, height: i32,
                            initial: i32): BoopsiObject? {
    return cl_boopsi_new_string(window, id, x, y, width, height, initial);
}

/// Adds the object to the window and refreshes it.
export func attachObject(borrow window: Window,
                         borrow object: BoopsiObject): bool {
    return cl_boopsi_attach(object, window);
}

/// Removes the object from its window and refreshes the remaining list.
export func detachObject(borrow object: BoopsiObject): void {
    cl_boopsi_detach(object);
}

/// Sets the gadget's integer value; the object must be attached.
export func setStringValue(borrow object: BoopsiObject, value: i32): bool {
    return cl_boopsi_set_value(object, value);
}

/// Returns the gadget's integer value, or 0 for a null object.
export func stringValue(borrow object: BoopsiObject): i32 {
    return cl_boopsi_value(object);
}

/// Detaches if needed and disposes the object.
export func disposeObject(take object: BoopsiObject): void {
    cl_boopsi_dispose(object);
}
