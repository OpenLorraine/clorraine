//! Amiga BOOPSI colorwheel object (Kickstart 3.0+).
//!
//! This module belongs to `hosted-amiga`; the host, `hosted-amiga-13`, and
//! freestanding profiles reject it with `E11200`. A `BoopsiObject` owns a
//! native `colorwheel.gadget`; attach it to a window, set/read its hue, then
//! detach/dispose before the window closes.

module std.amiga.boopsi;

import { Window } from std.amiga.intuition;

/// A BOOPSI colorwheel object. The generated drop disposes it.
export handle BoopsiObject freedBy cl_boopsi_dispose;

ffi stdboopsi {
    func cl_boopsi_new_colorwheel(borrow window: Window, id: i32,
                                  x: i32, y: i32, width: i32,
                                  height: i32): BoopsiObject?;
    func cl_boopsi_attach(borrow object: BoopsiObject,
                          borrow window: Window): bool;
    func cl_boopsi_detach(borrow object: BoopsiObject): void;
    func cl_boopsi_set_hue(borrow object: BoopsiObject, hue: u32): bool;
    func cl_boopsi_hue(borrow object: BoopsiObject): u32;
    func cl_boopsi_dispose(take object: BoopsiObject): void;
}

/// Creates a colorwheel object on `window`, or returns null.
///
/// The object uses `WHEEL_Screen` from the window's screen; `id` is 1..65535.
export func newColorWheel(borrow window: Window, id: i32, x: i32, y: i32,
                          width: i32, height: i32): BoopsiObject? {
    return cl_boopsi_new_colorwheel(window, id, x, y, width, height);
}

/// Adds the object to the window and refreshes it.
export func attachObject(borrow window: Window,
                         borrow object: BoopsiObject): bool {
    return cl_boopsi_attach(object, window);
}

/// Removes the object from its window and refreshes the remaining list.
export func detachObject(borrow object: BoopsiObject): void {
    cl_boopsi_detach(object);
}

/// Sets the colorwheel hue; the object must be attached.
export func setColorWheelHue(borrow object: BoopsiObject, hue: u32): bool {
    return cl_boopsi_set_hue(object, hue);
}

/// Returns the colorwheel hue.
export func colorWheelHue(borrow object: BoopsiObject): u32 {
    return cl_boopsi_hue(object);
}

/// Detaches if needed and disposes the object.
export func disposeObject(take object: BoopsiObject): void {
    cl_boopsi_dispose(object);
}
