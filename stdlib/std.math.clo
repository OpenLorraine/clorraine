//! Fixed-point math helpers for demos and geometry.
//!
//! The helpers are pure Clorraine, so they are available on the host and both
//! hosted-Amiga profiles. They avoid the 68000's soft-float library: angles are
//! integer steps around a 256-step turn and sine results are scaled by 256.
//!
//! `sin(64)` is the positive peak (256), `sin(128)` is zero, and `sin(192)` is
//! the negative peak (-256). `cos(a)` is `sin(a + 64)`. `sqrt` returns the
//! integer floor of the square root and returns zero for negative input.

module std.math;

/// Returns `sin(angle)` scaled by 256.
///
/// `angle` is measured in 256 steps per turn; values outside 0..255 wrap. The
/// result is in -256..=256 and is exact at the quarter turns. The table stores
/// one quarter wave; the other quadrants are mirrored.
export func sin(angle: i32): i32 {
    let table: i32[65] = [
        0, 6, 13, 19, 25, 31, 38, 44, 50, 56, 62, 68, 74, 80, 86, 92,
        98, 104, 109, 115, 121, 126, 132, 137, 142, 147, 152, 157, 162, 167, 172, 177,
        181, 185, 190, 194, 198, 202, 206, 209, 213, 216, 220, 223, 226, 229, 231, 234,
        237, 239, 241, 243, 245, 247, 248, 250, 251, 252, 253, 254, 255, 255, 256, 256,
        256,
    ];
    let a: i32 = ((angle % 256) + 256) % 256;
    if (a <= 64) {
        return table[usize(a)];
    }
    if (a <= 128) {
        return table[usize(128 - a)];
    }
    if (a <= 192) {
        return -table[usize(a - 128)];
    }
    return -table[usize(256 - a)];
}

/// Returns `cos(angle)` scaled by 256.
///
/// `angle` uses the same 256-step turn as `sin`; the result is in -256..=256.
export func cos(angle: i32): i32 {
    return sin(((angle % 256) + 256) % 256 + 64);
}

/// Returns the integer floor of the square root of `value`.
///
/// Negative input returns zero. The result is exact for every non-negative
/// `i32` the Newton iteration can represent; the loop divides only by a
/// positive current estimate.
export func sqrt(value: i32): i32 {
    if (value <= 0) {
        return 0;
    }
    let x: i32 = value;
    let y: i32 = value / 2 + value % 2;
    while (y < x) {
        x = y;
        y = (x + value / x) / 2;
    }
    return x;
}
