//! Amiga advanced services: expansion boards, the PCMCIA card resource, and
//! raw-key mapping.
//!
//! This module belongs to the hosted-Amiga profiles that provide the 2.0+
//! libraries. The host and `hosted-amiga-13` profiles reject it with `E11200`.
//! The wrappers reach the profile C shim through `ffi`, so application code
//! never writes `ffi` and never touches `unsafe`.
//!
//! Expansion-board enumeration is read-only; the `ConfigDev` nodes belong to
//! `expansion.library` and are never freed here. `cardPresent`/`cardStatus`
//! treat the optional `card.resource` as absent without failing. `mapRawKey`
//! returns the text for a raw key, or `null` when the keymap library is absent
//! or the key is unmapped. The ROM default keymap maps the raw keys the
//! acceptance demo checks.

module std.amiga.expansion;

ffi stdexpansion {
    func cl_expansion_board_count(): i32;
    func cl_expansion_board_manufacturer(index: i32): u16;
    func cl_expansion_board_product(index: i32): u8;
    func cl_expansion_board_serial(index: i32): u32;
    func cl_expansion_board_kind(index: i32): u8;
    func cl_card_present(): bool;
    func cl_card_status(): u32;
    func cl_map_raw_key(code: u16, qualifier: u16): String?;
}

/// Returns the number of `ConfigDev` boards, or 0 when the library is absent.
///
/// The nodes are owned by `expansion.library`; this wrapper only counts them.
export func expansionBoardCount(): i32 {
    return cl_expansion_board_count();
}

/// Returns the board's manufacturer id, or 0 for an out-of-range index.
export func expansionBoardManufacturer(index: i32): u16 {
    return cl_expansion_board_manufacturer(index);
}

/// Returns the board's product id, or 0 for an out-of-range index.
export func expansionBoardProduct(index: i32): u8 {
    return cl_expansion_board_product(index);
}

/// Returns the board's serial number, or 0 for an out-of-range index.
export func expansionBoardSerial(index: i32): u32 {
    return cl_expansion_board_serial(index);
}

/// Returns the board's `er_Type`, or 0 for an out-of-range index.
export func expansionBoardKind(index: i32): u8 {
    return cl_expansion_board_kind(index);
}

/// True when `card.resource` can be opened.
///
/// The resource is optional; a machine without PCMCIA support returns false.
export func cardPresent(): bool {
    return cl_card_present();
}

/// Returns the card status word, or 0 when the resource is absent.
///
/// The bits are the `card.resource` status bits; a bare machine with no card
/// returns 0.
export func cardStatus(): u32 {
    return cl_card_status();
}

/// Maps a raw key code and qualifier to text, or returns `null`.
///
/// `qualifier` uses the `IEQUALIFIER_*` bits. The ROM default keymap maps the
/// raw keys the acceptance demo checks; a Workbench installation with
/// additional keymaps can map more.
export func mapRawKey(code: u16, qualifier: u16): String? {
    return cl_map_raw_key(code, qualifier);
}
