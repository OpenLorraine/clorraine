{
  "name": "clorraine",
  "displayName": "Clorraine",
  "description": "Clorraine language support: compiler diagnostics, hover, definition, completion, and symbols.",
  "version": "1.2.0",
  "publisher": "openlorraine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenLorraine/clorraine"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:clorraine"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "clorraine.build", "title": "Clorraine: Build" },
      { "command": "clorraine.run", "title": "Clorraine: Run" },
      { "command": "clorraine.runInFsUae", "title": "Clorraine: Run in FS-UAE" }
    ],
    "languages": [
      {
        "id": "clorraine",
        "aliases": ["Clorraine", "clorraine"],
        "extensions": [".clo"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clorraine",
        "scopeName": "source.clorraine",
        "path": "./syntaxes/clorraine.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Clorraine",
      "properties": {
        "clorraine.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Language server executable. Empty searches CLORRAINE_LSP, ~/.clorraine/bin, trusted development builds, and PATH."
        },
        "clorraine.driver.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Clorraine driver executable. Empty searches ~/.clorraine/bin, trusted development builds, and PATH."
        },
        "clorraine.sdk.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Native Amiga SDK root. Empty lets the driver discover its SDK."
        },
        "clorraine.fsUae.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Native Linux FS-UAE executable used by Run in FS-UAE."
        },
        "clorraine.kickstart.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Locally licensed Kickstart ROM used by Run in FS-UAE."
        },
        "clorraine.profile": {
          "type": "string",
          "enum": ["hosted-amiga", "hosted-amiga-13", "host", "freestanding"],
          "default": "hosted-amiga",
          "description": "Compiler profile shared by diagnostics, navigation and Build/Run actions."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run stage && node --test test/*.test.ts",
    "stage": "node scripts/stage.mjs",
    "package": "npm run build && npm run stage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
