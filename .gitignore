# Amiga build outputs
*.o
*.a
*.prg
*.hunk
*.lha
*.elf

# Host build outputs
/build/
/target/
/examples/hosted-skeleton/build/
/spikes/*/build/

# Local SDK configuration (host paths, ROM/ADF folder)
/docker/.env
/docker/compose.override.yaml

# Editor and OS files
.DS_Store
*.swp
*~

# Demo tool dependencies
node_modules/

# Generated demo media (do not commit; the poster PNG is committed)
/demo/*.mp4
/demo/*.gif
/demo/out/

# Python bytecode from the benchmark harness
__pycache__/
*.pyc

# Packaged VS Code extension and its build output
*.vsix
/build/vscode/
/tools/vscode/out/

# Documentation site dependencies and generated output
/site/node_modules/
/site/.vitepress/cache/
/site/.vitepress/dist/
/site/.vitepress/.temp/
