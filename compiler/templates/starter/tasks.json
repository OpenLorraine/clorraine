{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clorraine: Run in FS-UAE",
      "type": "process",
      "command": "@CLORRAINE@",
      "args": ["run", "-p", "hosted-amiga", "--emulator", "main.clo"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Clorraine: Build for the Amiga",
      "type": "process",
      "command": "@CLORRAINE@",
      "args": ["build", "-p", "hosted-amiga", "main.clo"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
