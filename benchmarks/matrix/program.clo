// Exercises multi-extent fixed arrays, a row view passed to a borrow parameter,
// nested indexing, and helper calls.
module bench.Matrix;

import { println } from std.io;

const N: i32 = 32;

func rowSum(row: i32[N]): i32 {
    let total: i32 = 0;
    let j: i32 = 0;
    while (j < N) {
        total = total + row[j];
        j = j + 1;
    }
    return total;
}

func main(): i32 {
    let a: i32[N][N] = [; [; 0]];
    let i: i32 = 0;
    while (i < N) {
        let j: i32 = 0;
        while (j < N) {
            a[i][j] = i * N + j;
            j = j + 1;
        }
        i = i + 1;
    }
    let total: i32 = 0;
    i = 0;
    while (i < N) {
        total = total + rowSum(a[i]);
        i = i + 1;
    }
    println($"matrix: {total}");
    return 0;
}
