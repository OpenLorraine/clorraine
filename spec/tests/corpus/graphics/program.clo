// Opens a custom screen, draws colored bars and a diagonal, holds it for about
// thirty seconds, and reports the result. It is the acceptance target for the
// screen lifecycle and the drawing calls on real AmigaOS: the scene is drawn in
// a helper that owns the screen, so the screen is released before the program
// reports success.
module tests.corpus.Graphics;

import { Screen, openScreen } from std.amiga.intuition;
import { setColor, fill, draw, clear } from std.amiga.graphics;
import { String, stringOf, toCString } from std.text;
import { println } from std.io;
import { delayTicks } from std.amiga.dos;

/// Draws the scene and holds the screen, then releases it on return.
///
/// Returns zero on success and one when the screen cannot be opened. The screen
/// and the title drop when this function returns, before the caller reports the
/// result.
func drawScene(): i32 {
    let title: String = stringOf("Clorraine graphics");
    let screen: Screen? = openScreen(320, 256, 4, toCString(title));
    if (screen == null) {
        return 1;
    }

    setColor(screen, 0, 0, 0, 0);
    setColor(screen, 1, 255, 32, 32);
    setColor(screen, 2, 32, 255, 32);
    setColor(screen, 3, 32, 32, 255);
    clear(screen, 0);

    let i: i32 = 0;
    while (i < 8) {
        fill(screen, i * 40, 0, i * 40 + 39, 255, u8(i % 3 + 1));
        i = i + 1;
    }
    draw(screen, 0, 0, 319, 255, 3);

    delayTicks(1500);
    return 0;
}

func main(): i32 {
    let rc: i32 = drawScene();
    if (rc != 0) {
        println("graphics: failed");
        return rc;
    }
    println("graphics: ok");
    return 0;
}
