struct Holder<T> {
    value: T;
}

func makeHolder<T>(x: T): Holder<T> {
    return Holder<T> { value: x };
}

func demo(): void {
    let counter: i32 = 0;
    makeHolder([borrow counter] (n: i32) => { counter = counter + n; });
}

func main(): i32 {
    return 0;
}
