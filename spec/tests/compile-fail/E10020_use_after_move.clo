// expect-error E10020
// trigger: read of a String after it was moved
module tests.compile_fail.E10020;

func observe(s: String): void {
}

func demo(): void {
    let n: u32 = 1;
    let s: String = $"n={n}";
    let t: String = s;      // move: s is invalid after this
    observe(s);             // E10020: s was moved and cannot be used
    observe(t);
}

func main(): i32 {
