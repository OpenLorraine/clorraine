// expect-error E10031
// trigger: mutating a String while an implicitly-widened str view of it is live
module tests.compile_fail.E10031;

import { stringOf } from std.text;

func demo(): void {
    let s: String = stringOf("hello");
    let v: str = s;            // String widens to str: a shared loan of s
    if (len(v) == 0) {
        return;
    }
    s = stringOf("world");     // E10031: cannot modify s while the widened view is live
}

func main(): i32 {
    return 0;
}
