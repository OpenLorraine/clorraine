// expect-warning W10001
// trigger: a writable lend of a duplicable struct; writes affect only the copy
module tests.compile_fail.W10001;

struct Point {
    x: i32;
    y: i32;
}

func bump(borrow p: Point): void {
    p.x = p.x + 1;
}

func main(): i32 {
    let p = Point { x: 1, y: 2 };
    bump(p);
    return p.x;
}
